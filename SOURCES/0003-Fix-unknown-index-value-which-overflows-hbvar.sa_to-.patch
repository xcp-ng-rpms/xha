From 4fbe895f4f3b6df2642774da3b7c241133adcb75 Mon Sep 17 00:00:00 2001
From: Erwan Croze <erwancroze@gmail.com>
Date: Mon, 19 Oct 2026 11:44:55 +0200
Subject: [PATCH] Fix unknown index value which overflows hbvar.sa_to (#5)

Fix a potential memory crash access.

Upstream PR: https://github.com/xenserver/xha/pull/33

Signed-off-by: Erwan Croze <erwan.croze@vates.tech>
---
 daemon/heartbeat.c | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/daemon/heartbeat.c b/daemon/heartbeat.c
index 7272174..0bb9744 100755
--- a/daemon/heartbeat.c
+++ b/daemon/heartbeat.c
@@ -1107,14 +1107,13 @@ send_hb()
     if (!hb_check_fist("hb.isolate") &&
         !fist_on("hb.send.lostpacket"))
     {
-        const socket_address *ss = &hbvar.sa_to[index];
-        const socklen_t dest_len = ss->sa.sa_family == AF_INET ? sizeof(ss->sa_in) : sizeof(ss->sa_in6);
-
         for (index = 0; _is_configured_host(index); index++)
         {
             if (index != _my_index)
             {
-                const int ret = sendto(hbvar.socket, &pkt, sizeof(pkt), 0, &hbvar.sa_to[index].sa, dest_len);
+                const socket_address *ss = &hbvar.sa_to[index];
+                const socklen_t dest_len = ss->sa.sa_family == AF_INET ? sizeof(ss->sa_in) : sizeof(ss->sa_in6);
+                const int ret = sendto(hbvar.socket, &pkt, sizeof(pkt), 0, &ss->sa, dest_len);
                 if (ret == -1)
                 {
                     log_message(MTC_LOG_ERR, "HB: sendto() failed. (sys %d)\n", errno);
